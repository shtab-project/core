# Создать / дополнить .env случайными секретами:  python infra/scripts/gen_env.py
SHTAB_DOMAIN=shtab.localhost
SHTAB_PUBLIC_URL=http://shtab.localhost

# PostgreSQL
POSTGRES_PASSWORD=
AUTHENTIK_DB_PASSWORD=
SHTAB_DB_PASSWORD=

# Authentik
AUTHENTIK_SECRET_KEY=
# Учётка администратора Authentik (akadmin) создаётся при первом запуске
AUTHENTIK_BOOTSTRAP_EMAIL=admin@shtab.localhost
AUTHENTIK_BOOTSTRAP_PASSWORD=
# API-токен akadmin — для автоматизации (ядро будет создавать приглашения)
AUTHENTIK_BOOTSTRAP_TOKEN=

# OIDC-клиент «Shtab» (используется в blueprint и в ядре)
SHTAB_OIDC_CLIENT_ID=shtab
SHTAB_OIDC_CLIENT_SECRET=

# Ядро
SHTAB_AUTH_URL=http://auth.shtab.localhost
# Подпись служебных cookie ядра
SHTAB_SECRET_KEY=
